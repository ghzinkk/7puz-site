     */

    document
      .querySelectorAll(".navlinks a")
      .forEach(function(link){

        link.addEventListener(
          "click",
          function(){

            const links =
              document.querySelector(".navlinks");

            const button =
              document.querySelector(".mobile-menu");

            links.classList.remove("mobile-open");

            if(window.innerWidth <= 900){
              links.style.display = "none";
            }

            button.setAttribute(
              "aria-expanded",
              "false"
            );

          }
        );

      });


    /* =========================================================
       PROTEÇÃO BÁSICA CONTRA CÓPIA CASUAL
       
       IMPORTANTE:
       Isto NÃO é segurança real.
       Um usuário experiente ainda consegue acessar
       o código pelo navegador.
       ========================================================= */

    document.addEventListener(
      "contextmenu",
      function(event){

        event.preventDefault();

      }
    );


    document.addEventListener(
      "dragstart",
      function(event){

        if(
          event.target.tagName === "IMG" ||
          event.target.tagName === "A"
        ){

          event.preventDefault();

        }

      }
    );


    /*
     * Bloqueia alguns atalhos comuns usados para
     * copiar/visualizar a página.
     *
     * Os atalhos não são uma proteção verdadeira.
     */

    document.addEventListener(
      "keydown",
      function(event){

        const key =
          event.key.toLowerCase();


        /* Ctrl + U */
        if(
          event.ctrlKey &&
          key === "u"
        ){

          event.preventDefault();
          return;

        }


        /* Ctrl + S */
        if(
          event.ctrlKey &&
          key === "s"
        ){

          event.preventDefault();
          return;

        }


        /* Ctrl + Shift + I */
        if(
          event.ctrlKey &&
          event.shiftKey &&
