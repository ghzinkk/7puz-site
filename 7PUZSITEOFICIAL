      <div class="cart-row subtotal"><span>SUBTOTAL</span><span id="cartSubtotal">R$ 0,00</span></div>
      <div class="cart-row"><strong>VALOR TOTAL:</strong><strong class="cart-total" id="cartTotal">R$ 0,00</strong></div>
      <button class="cart-checkout" id="cartCheckout" type="button" onclick="showCartCheckout()">IR PARA A COMPRA →</button>
