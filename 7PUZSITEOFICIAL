  <script>
    const cartPrices = { basic:2190, advanced:7990, premium:14990, win11:7490, win10:7490 };
    const cartKey = '7puz-cart-v1';
    function sanitizeCart(value) {
      return Array.isArray(value) ? [...new Set(value.filter(id => Object.hasOwn(cartPrices,id)))] : [];
    }
    function cartSum(items) { return sanitizeCart(items).reduce((total,id) => total + cartPrices[id],0); }
    function money(cents) { return (cents / 100).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}); }
    let cartItems = [];
    try { cartItems = sanitizeCart(JSON.parse(localStorage.getItem(cartKey) || '[]')); } catch (_) {}
    let cartCheckoutMode = false;
    let cartNoticeTimer;
    function saveCart() {
      try { localStorage.setItem(cartKey,JSON.stringify(cartItems)); } catch (_) {}
      renderCart();
    }
    function addToCart(id) {
      if (!Object.hasOwn(cartPrices,id)) return;
      const exists = cartItems.includes(id);
      if (!exists) cartItems.push(id);
      cartCheckoutMode = false;
      saveCart();
      openCart();
      const notice = document.getElementById('cartNotice');
      notice.textContent = exists ? 'Este plano já está no carrinho.' : 'Plano adicionado ao carrinho.';
      notice.hidden = false;
      clearTimeout(cartNoticeTimer);
      cartNoticeTimer = setTimeout(() => { notice.hidden = true; },2500);
    }
    function removeFromCart(id) {
      cartItems = cartItems.filter(item => item !== id);
      if (!cartItems.length) cartCheckoutMode = false;
      saveCart();
    }
    function openCart() {
      renderCart();
      const dialog = document.getElementById('cartDialog');
      if (!dialog.open) dialog.showModal();
      document.body.classList.add('modal-open');
    }
    function closeCart() { document.getElementById('cartDialog').close(); }
    function showCartCheckout() {
      if (!cartItems.length) return;
      cartCheckoutMode = true;
      renderCart();
      document.querySelector('.checkout-link')?.focus();
    }
    function renderCart() {
      document.getElementById('cartCount').textContent = cartItems.length;
      document.getElementById('cartSummary').textContent = cartItems.length + (cartItems.length === 1 ? ' item selecionado' : ' itens selecionados');
      const total = money(cartSum(cartItems));
      document.getElementById('cartSubtotal').textContent = total;
      document.getElementById('cartTotal').textContent = total;
      document.getElementById('cartCheckout').disabled = !cartItems.length;
      const body = document.getElementById('cartBody');
      body.replaceChildren();
      if (!cartItems.length) {
        body.innerHTML = '<div class="cart-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M2 3h3l4 13h11l3-9H6"/><circle cx="10" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg><strong>SEU CARRINHO ESTÁ VAZIO</strong><p>ADICIONE PLANOS PARA COMEÇAR</p></div>';
      }
      if (cartCheckoutMode) {
        const note = document.createElement('p');
        note.className = 'checkout-note';
        note.textContent = 'Escolha um item abaixo para abrir seu pagamento. Cada plano possui um checkout separado; os itens permanecem no carrinho até você removê-los.';
        body.appendChild(note);
      }
      cartItems.forEach(id => {
        const item = document.createElement('article');
        item.className = 'cart-item';
        const info = document.createElement('div');
        const title = document.createElement('h3');
        title.textContent = plans[id].title;
        const price = document.createElement('p');
        price.textContent = money(cartPrices[id]);
        info.append(title,price);
        const remove = document.createElement('button');
        remove.type = 'button'; remove.className = 'cart-remove'; remove.textContent = 'Remover';
        remove.setAttribute('aria-label','Remover ' + plans[id].title);
        remove.addEventListener('click',() => removeFromCart(id));
        item.append(info,remove);
        if (cartCheckoutMode) {
          const pay = document.createElement('a');
          pay.className = 'checkout-link'; pay.href = plans[id].payment;
          pay.target = '_blank'; pay.rel = 'noopener noreferrer';
          pay.textContent = 'Pagar ' + money(cartPrices[id]) + ' no Mercado Pago ↗';
          info.appendChild(pay);
        }
        body.appendChild(item);
      });
      document.querySelectorAll('[data-cart-add]').forEach(button => {
        button.textContent = cartItems.includes(button.dataset.cartAdd) ? '✓ No carrinho · Ver' : 'Adicionar ao carrinho';
      });
    }
    document.querySelectorAll('.plan button[onclick], .combo button[onclick]').forEach(button => {
      const match = button.getAttribute('onclick').match(/openPlan\('([^']+)'\)/);
      if (!match) return;
      const add = document.createElement('button');
      add.type = 'button'; add.className = 'cart-add'; add.dataset.cartAdd = match[1];
      add.addEventListener('click',() => addToCart(match[1]));
      button.after(add);
    });
    document.getElementById('cartDialog').addEventListener('close',() => {
      if (!document.getElementById('planModal').classList.contains('active')) document.body.classList.remove('modal-open');
    });
    document.getElementById('cartDialog').addEventListener('click',event => {
      const rect = event.currentTarget.getBoundingClientRect();
      if (event.target === event.currentTarget && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) closeCart();
    });
    window.addEventListener('storage',event => {
      if (event.key !== cartKey && event.key !== null) return;
      try { cartItems = sanitizeCart(JSON.parse(event.newValue || '[]')); } catch (_) { cartItems = []; }
      renderCart();
    });
    renderCart();
  </script>
