<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta
    name="description"
    content="7PUZ Tweaks — otimização profissional para Windows e PC. Escolha seu plano e melhore desempenho, estabilidade e responsividade."
  >

  <meta name="theme-color" content="#050505">

  <title>7PUZ Tweaks — Otimização de PC</title>

  <style>
    :root{
      --bg:#050505;
      --bg2:#0a0a0c;
      --card:#101012;
      --card2:#151518;
      --text:#f5f5f5;
      --muted:#99999f;
      --muted2:#6f6f75;
      --line:rgba(255,255,255,.09);
      --white:#fff;
      --black:#070707;
      --max:1180px;
      --radius:20px;
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:
        radial-gradient(circle at 50% -15%,rgba(255,255,255,.12),transparent 35%),
        linear-gradient(180deg,#050505 0%,#09090b 48%,#040404 100%);
      color:var(--text);
      line-height:1.6;
      overflow-x:hidden;

      /* Proteção básica contra seleção casual */
      -webkit-user-select:none;
      -moz-user-select:none;
      user-select:none;
    }

    body.modal-open{
      overflow:hidden;
    }

    a{
      text-decoration:none;
      color:inherit;
      -webkit-user-drag:none;
    }

    img{
      -webkit-user-drag:none;
      user-select:none;
    }

    button{
      font:inherit;
    }

    .container{
      width:min(var(--max),calc(100% - 40px));
      margin:auto;
    }

    /* =========================
       NAVBAR
    ========================= */

    .topbar{
      position:fixed;
      top:0;
      left:0;
      right:0;
      z-index:50;
      border-bottom:1px solid rgba(255,255,255,.07);
      background:rgba(5,5,5,.75);
      backdrop-filter:blur(18px);
    }

    nav{
      height:76px;
      display:flex;
      align-items:center;
      justify-content:space-between;
    }

    .brand{
      font-weight:950;
      letter-spacing:-.05em;
      font-size:1.15rem;
    }

    .brand span{
      color:#77777d;
    }

    .navlinks{
      display:flex;
      gap:28px;
      color:#a7a7ad;
      font-size:.9rem;
    }

    .navlinks a{
      transition:.2s;
    }

    .navlinks a:hover{
      color:#fff;
    }

    .nav-cta{
      padding:11px 17px;
      border:1px solid #fff;
      border-radius:10px;
      background:#fff;
      color:#080808;
      font-weight:850;
      font-size:.85rem;
      transition:.2s;
    }

    .nav-cta:hover{
      transform:translateY(-2px);
    }

    .mobile-menu{
      display:none;
      background:none;
      border:0;
      color:#fff;
      font-size:1.4rem;
      cursor:pointer;
    }

    /* =========================
       HERO
    ========================= */

    .hero{
      padding:175px 0 105px;
      position:relative;
      overflow:hidden;
    }

    .hero:before{
      content:"";
      position:absolute;
      width:620px;
      height:620px;
      left:50%;
      top:40px;
      transform:translateX(-50%);
      background:rgba(255,255,255,.075);
      filter:blur(120px);
      border-radius:50%;
      pointer-events:none;
    }

    .hero-inner{
      position:relative;
      text-align:center;
      max-width:900px;
      margin:auto;
    }

    .eyebrow{
      display:inline-flex;
      gap:8px;
      align-items:center;
      border:1px solid var(--line);
      padding:7px 12px;
      border-radius:999px;
      color:#bdbdc3;
      background:rgba(255,255,255,.03);
      font-size:.76rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.1em;
    }

    .dot{
      width:7px;
      height:7px;
      background:#fff;
      border-radius:50%;
      box-shadow:0 0 16px #fff;
    }

    h1{
      font-size:clamp(3.1rem,7vw,6.5rem);
      line-height:.92;
      letter-spacing:-.07em;
      margin:28px 0 25px;
    }

    h1 em{
      font-style:normal;
      color:#77777d;
    }

    .hero p{
      font-size:1.12rem;
      color:#a7a7ad;
      max-width:700px;
      margin:auto;
    }

    .actions{
      display:flex;
      justify-content:center;
      gap:12px;
      margin-top:34px;
      flex-wrap:wrap;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-height:50px;
      padding:0 22px;
      border-radius:12px;
      font-weight:850;
      cursor:pointer;
      transition:transform .2s,background .2s,border .2s;
      border:0;
    }

    .btn:hover{
      transform:translateY(-2px);
    }

    .btn-primary{
      background:#fff;
      color:#080808;
    }

    .btn-secondary{
      border:1px solid var(--line);
      background:#101013;
      color:#fff;
    }

    .hero-note{
      margin-top:16px!important;
      font-size:.78rem!important;
      color:#68686e!important;
    }

    /* =========================
       GERAL
    ========================= */

    section{
      padding:95px 0;
    }

    .section-head{
      max-width:720px;
      margin-bottom:45px;
    }

    .kicker{
      color:#8e8e95;
      font-size:.75rem;
      font-weight:900;
      letter-spacing:.14em;
      text-transform:uppercase;
    }

    h2{
      font-size:clamp(2rem,4vw,3.5rem);
      line-height:1.02;
      letter-spacing:-.05em;
      margin-top:10px;
    }

    .section-head p{
      color:#92929a;
      margin-top:15px;
    }

    /* =========================
       BENEFÍCIOS
    ========================= */

    .grid-3{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:16px;
    }

    .card{
      background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));
      border:1px solid var(--line);
      border-radius:var(--radius);
      padding:28px;
    }

    .icon{
      width:42px;
      height:42px;
      border-radius:12px;
      background:#fff;
      color:#080808;
      display:grid;
      place-items:center;
      font-weight:1000;
      margin-bottom:22px;
    }

    .card h3{
      font-size:1.08rem;
      margin-bottom:8px;
    }

    .card p{
      color:#909097;
      font-size:.94rem;
    }

    /* =========================
       PLANOS
    ========================= */

    .plans{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
      align-items:stretch;
    }

    .plan{
      position:relative;
      display:flex;
      flex-direction:column;
      background:
        linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.015));
      border:1px solid var(--line);
      border-radius:24px;
      padding:28px;
      transition:.25s;
    }

    .plan:hover{
      transform:translateY(-5px);
      border-color:rgba(255,255,255,.2);
      box-shadow:0 20px 60px rgba(0,0,0,.3);
    }

    .plan.featured{
      border-color:rgba(255,255,255,.35);
      background:
        linear-gradient(145deg,rgba(255,255,255,.085),rgba(255,255,255,.02));
    }

    .badge{
      position:absolute;
      top:18px;
      right:18px;
      background:#fff;
      color:#080808;
      padding:5px 9px;
      border-radius:999px;
      font-size:.66rem;
      font-weight:950;
      text-transform:uppercase;
      letter-spacing:.06em;
    }

    .plan-number{
      color:#73737a;
      font-size:.72rem;
      font-weight:900;
      letter-spacing:.1em;
      margin-bottom:18px;
    }

    .plan h3{
      font-size:1.4rem;
      letter-spacing:-.03em;
      margin-bottom:8px;
    }

    .plan-description{
      color:#85858c;
      font-size:.88rem;
      min-height:66px;
    }

    .plan-price{
      font-size:2.7rem;
      font-weight:950;
      letter-spacing:-.06em;
      margin:22px 0 4px;
    }

    .plan-price small{
      font-size:1rem;
      color:#85858b;
      font-weight:750;
    }

    .plan-price-note{
      color:#68686e;
      font-size:.72rem;
      margin-bottom:18px;
    }

    .plan ul{
      list-style:none;
      margin:4px 0 25px;
      flex:1;
    }

    .plan li{
      color:#c6c6cb;
      font-size:.86rem;
      padding:9px 0;
      border-bottom:1px solid var(--line);
    }

    .plan li::before{
      content:"✓";
      color:#fff;
      font-weight:900;
      margin-right:9px;
    }

    .plan .btn{
      width:100%;
    }

    .plans-extra{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:18px;
      margin-top:18px;
    }

    .combo{
      position:relative;
      background:linear-gradient(145deg,#151518,#0c0c0e);
      border:1px solid rgba(255,255,255,.14);
      border-radius:24px;
      padding:28px;
      display:flex;
      flex-direction:column;
    }

    .combo:hover{
      border-color:rgba(255,255,255,.28);
    }

    .combo-label{
      color:#8e8e95;
      font-size:.72rem;
      font-weight:900;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .combo h3{
      font-size:1.45rem;
      margin:6px 0;
    }

    .combo p{
      color:#85858c;
      font-size:.88rem;
      margin-bottom:18px;
    }

    .combo-price{
      font-size:2.5rem;
      font-weight:950;
      letter-spacing:-.06em;
      margin-bottom:18px;
    }

    .combo-price small{
      color:#85858b;
      font-size:.95rem;
    }

    .combo .btn{
      width:100%;
      margin-top:auto;
    }

    /* =========================
       PROCESSO
    ========================= */

    .showcase{
      border:1px solid var(--line);
      border-radius:28px;
      overflow:hidden;
      background:#0c0c0e;
    }

    .mock-top{
      height:46px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      padding:0 18px;
      gap:7px;
    }

    .mock-top i{
      width:8px;
      height:8px;
      border-radius:50%;
      background:#444;
    }

    .mock-content{
      padding:38px;
      display:grid;
      grid-template-columns:1.15fr .85fr;
      gap:28px;
    }

    .terminal{
      min-height:310px;
      border:1px solid var(--line);
      border-radius:16px;
      padding:22px;
      background:#080809;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      color:#a8a8ad;
      font-size:.82rem;
    }

    .terminal strong{
      color:#fff;
    }

    .terminal .ok{
      color:#c9c9cd;
    }

    .stats{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
    }

    .stat{
      border:1px solid var(--line);
      border-radius:16px;
      padding:22px;
      background:#111114;
    }

    .stat b{
      display:block;
      font-size:1.8rem;
      letter-spacing:-.05em;
    }

    .stat span{
      font-size:.78rem;
      color:#7e7e85;
    }

    /* =========================
       FAQ
    ========================= */

    .faq{
      max-width:850px;
      margin:auto;
    }

    details{
      border-bottom:1px solid var(--line);
      padding:20px 0;
    }

    summary{
      cursor:pointer;
      list-style:none;
      font-weight:800;
      display:flex;
      justify-content:space-between;
      gap:15px;
    }

    summary::-webkit-details-marker{
      display:none;
    }

    summary:after{
      content:"+";
      color:#888;
      font-size:1.2rem;
    }

    details[open] summary:after{
      content:"−";
    }

    details p{
      color:#909097;
      padding-top:13px;
      max-width:720px;
      -webkit-user-select:text;
      user-select:text;
    }

    /* =========================
       CTA FINAL
    ========================= */

    .final{
      text-align:center;
      border:1px solid var(--line);
      border-radius:28px;
      padding:75px 25px;
      background:
        radial-gradient(circle at 50% 0%,rgba(255,255,255,.09),transparent 50%),
        #0d0d0f;
    }

    .final p{
      color:#92929a;
      max-width:600px;
      margin:15px auto 25px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer{
      border-top:1px solid var(--line);
      padding:28px 0;
      color:#68686e;
      font-size:.78rem;
    }

    footer .foot{
      display:flex;
      justify-content:space-between;
      gap:15px;
    }

    /* =========================
       MODAL
    ========================= */

    .modal-overlay{
      position:fixed;
      inset:0;
      z-index:200;
      background:rgba(0,0,0,.78);
      backdrop-filter:blur(10px);
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
    }

    .modal-overlay.active{
      display:flex;
    }

    .modal{
      width:min(560px,100%);
      max-height:90vh;
      overflow:auto;
      background:linear-gradient(145deg,#18181b,#0d0d0f);
      border:1px solid rgba(255,255,255,.15);
      border-radius:24px;
      padding:30px;
      box-shadow:0 30px 100px rgba(0,0,0,.65);
      animation:modalIn .2s ease;

      /* Permite selecionar/copiar somente conteúdo necessário dentro do modal */
      -webkit-user-select:text;
      user-select:text;
    }

    @keyframes modalIn{
      from{
        opacity:0;
        transform:translateY(15px) scale(.98);
      }
      to{
        opacity:1;
        transform:none;
      }
    }

    .modal-header{
      display:flex;
      justify-content:space-between;
      gap:20px;
      align-items:flex-start;
      margin-bottom:20px;
    }

    .modal-header h3{
      font-size:1.7rem;
      letter-spacing:-.04em;
    }

    .close-modal{
      width:38px;
      height:38px;
      border:1px solid var(--line);
      background:#101013;
      color:#fff;
      border-radius:10px;
      cursor:pointer;
      font-size:1.2rem;
      flex-shrink:0;
    }

    .modal-price{
      font-size:2.7rem;
      font-weight:950;
      letter-spacing:-.06em;
      margin-bottom:20px;
    }

    .modal-description{
      color:#9999a1;
      font-size:.92rem;
      margin-bottom:22px;
    }

    .modal h4{
      font-size:.8rem;
      text-transform:uppercase;
      letter-spacing:.12em;
      color:#77777e;
      margin-bottom:10px;
    }

    .modal ul{
      list-style:none;
      margin-bottom:25px;
    }

    .modal li{
      color:#d0d0d4;
      padding:10px 0;
      border-bottom:1px solid var(--line);
      font-size:.9rem;
    }

    .modal li::before{
      content:"✓";
      color:#fff;
      font-weight:900;
      margin-right:10px;
    }

    .modal-payment{
      width:100%;
      -webkit-user-select:none;
      user-select:none;
    }

    .modal-note{
      text-align:center;
      color:#66666d;
      font-size:.7rem;
      margin-top:10px;
    }

    /* =========================
       REVEAL
    ========================= */

    .reveal{
      opacity:0;
      transform:translateY(18px);
      transition:opacity .7s ease,transform .7s ease;
    }

    .reveal.visible{
      opacity:1;
      transform:none;
    }

    /* =========================
       RESPONSIVO
    ========================= */

    @media(max-width:900px){

      .navlinks{
        display:none;
      }

      .mobile-menu{
        display:block;
      }

      .grid-3,
      .plans{
        grid-template-columns:1fr;
      }

      .plans-extra{
        grid-template-columns:1fr;
      }

      .mock-content{
        grid-template-columns:1fr;
      }

      .hero{
        padding-top:145px;
      }
    }

    @media(max-width:520px){

      .container{
        width:min(var(--max),calc(100% - 28px));
      }

      nav{
        height:68px;
      }

      .nav-cta{
        display:none;
      }

      section{
        padding:70px 0;
      }

      .hero{
        padding-bottom:65px;
      }

      h1{
        font-size:3.1rem;
      }

      .hero p{
        font-size:1rem;
      }

      .card,
      .plan,
      .combo{
        padding:22px;
      }

      .stats{
        grid-template-columns:1fr;
      }

      .mock-content{
        padding:20px;
      }

      .modal{
        padding:24px;
      }

      footer .foot{
        flex-direction:column;
      }
    }
      /* Visual inspirado na referência: superfícies escuras e contornos neon. */
    :root { --max:1380px; --radius:4px; --muted:#aaa3ab; }
    body { background:radial-gradient(ellipse at 12% 24%,#39242980,transparent 38%),radial-gradient(ellipse at 90% 65%,#291a3280,transparent 40%),#090708; }
    body::before { content:""; position:fixed; inset:0; pointer-events:none; z-index:-1; opacity:.6; background-image:radial-gradient(circle,#e6a4b3 1px,transparent 2px),radial-gradient(circle,#c68899 1px,transparent 3px); background-size:233px 277px,397px 331px; background-position:37px 59px,140px 120px; }
    .brand span,h1 em { color:#d28b9a; }
    .hero:before { background:#ce8299; opacity:.18; }
    .dot { background:#e597ad; box-shadow:0 0 16px #e597ad; }
    .btn,.nav-cta { border-radius:0; clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px); }
    .hero .btn-primary,.nav-cta { background:#dc96a6; border-color:#dc96a6; }
    section[id] { scroll-margin-top:90px; }
    #planos { position:relative; padding-top:75px; }
    #planos .section-head { text-align:center; max-width:none; margin-bottom:65px; }
    #planos .section-head .kicker { color:#d28b9a; }
    #planos h2 { font-size:clamp(2.5rem,5.4vw,5rem); font-weight:950; text-transform:uppercase; letter-spacing:-.055em; }
    #planos h2 span { color:#d28b9a; }
    #planos .section-head p { max-width:610px; margin:20px auto 0; }
    .plans { gap:22px; padding-top:24px; }
    .plan,.combo { --accent:#00ee29; --tint:#102512; border:0; border-radius:0; padding:38px 32px 32px; background:linear-gradient(130deg,var(--accent),#ffffff0d 45%,#ffffff10); clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,28px 100%,0 calc(100% - 28px)); isolation:isolate; }
    .plan::before,.combo::before { content:""; position:absolute; inset:2px; background:linear-gradient(145deg,var(--tint),#120f11 45%); clip-path:polygon(0 0,calc(100% - 27px) 0,100% 27px,100% 100%,27px 100%,0 calc(100% - 27px)); z-index:-1; }
    .plan::after,.combo::after { content:""; position:absolute; right:12px; bottom:12px; width:19px; height:19px; border-right:1px solid var(--accent); border-bottom:1px solid var(--accent); opacity:.3; }
    .plan.featured { --accent:#f000ee; --tint:#2c142a; background:linear-gradient(130deg,var(--accent),#ffffff0d 48%,#f000ee40); transform:translateY(-24px); }
    .plan:nth-child(3) { --accent:#8d27ff; --tint:#20152f; }
    .plan:hover { transform:translateY(-7px); }
    .plan.featured:hover { transform:translateY(-31px); }
    .plan-number { color:var(--accent); font-size:.8rem; letter-spacing:.2em; margin:18px 0 3px; }
    .plan-symbol { width:43px; height:43px; display:grid; place-items:center; color:var(--accent); background:color-mix(in srgb,var(--accent) 8%,transparent); }
    .plan-symbol svg { width:25px; height:25px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linejoin:round; stroke-linecap:round; }
    .plan h3 { font-size:clamp(1.6rem,2.2vw,2.1rem); text-transform:uppercase; font-weight:950; line-height:1.05; margin:0 0 20px; }
    .plan-description { color:#aaa2ab; min-height:90px; font-size:1rem; line-height:1.6; }
    .plan-price { font-size:clamp(2.7rem,4vw,3.5rem); line-height:1.1; margin:24px 0 14px; letter-spacing:-.055em; }
    .plan-price small,.combo-price small { font-size:inherit; color:inherit; font-weight:inherit; }
    .plan-price-note { font-size:.8rem; color:#958b95; margin-bottom:24px; }
    .plan ul { margin:0 0 30px; }
    .plan li { position:relative; padding:9px 0 9px 28px; border:0; font-size:1rem; color:#bdb6be; }
    .plan li::before { content:"✓"; position:absolute; left:0; top:14px; border:1.5px solid var(--accent); color:var(--accent); border-radius:50%; width:15px; height:15px; line-height:12px; font-size:10px; text-align:center; }
    .plan .btn,.combo .btn { min-height:58px; text-transform:uppercase; font-size:.875rem; letter-spacing:.16em; color:var(--accent); border:1px solid var(--accent); background:#100d10; }
    .plan.featured .btn,.plan:nth-child(3) .btn { background:var(--accent); color:#080608; }
    .plan .btn:hover,.combo .btn:hover { filter:brightness(1.2); background:var(--accent); color:#050505; }
    .badge { top:25px; right:30px; color:var(--accent); border:1px solid #f000ee40; background:#f000ee15; border-radius:0; font-size:.75rem; padding:5px 10px; }
    .plans-extra { margin-top:26px; gap:22px; }
