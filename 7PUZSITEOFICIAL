  <script>
    // Elementos decorativos não interferem na navegação ou no pagamento.
    const motionControl = document.createElement('button');
    motionControl.className = 'motion-toggle';
    motionControl.type = 'button';
    motionControl.textContent = 'Ⅱ Pausar animações';
    motionControl.setAttribute('aria-pressed', 'false');
    motionControl.addEventListener('click', function() {
      const paused = document.documentElement.classList.toggle('motion-paused');
      motionControl.textContent = paused ? '▶ Ativar animações' : 'Ⅱ Pausar animações';
      motionControl.setAttribute('aria-pressed', String(paused));
    });
    document.body.appendChild(motionControl);
    const ambient = document.createElement('div');
    ambient.className = 'ambient-motion';
    ambient.setAttribute('aria-hidden', 'true');
    for (let i = 0; i < 2; i++) {
      const glow = document.createElement('div');
      glow.className = 'ambient-glow';
      ambient.appendChild(glow);
    }
    for (let i = 0; i < 36; i++) {
      const particle = document.createElement('i');
      particle.className = 'ambient-particle';
      particle.style.setProperty('--x', ((i * 43) % 100) + '%');
      particle.style.setProperty('--size', (2 + i % 3) + 'px');
      particle.style.setProperty('--duration', (6 + i % 7) + 's');
      particle.style.setProperty('--delay', (-i * 1.7) + 's');
      ambient.appendChild(particle);
    }
    for (let i = 0; i < 5; i++) {
      const streak = document.createElement('div');
      streak.className = 'light-streak';
      streak.style.setProperty('--top', (20 + i * 19) + '%');
      streak.style.setProperty('--delay', (-i * 1.4) + 's');
      ambient.appendChild(streak);
    }
    document.body.prepend(ambient);
    document.addEventListener('click', function(event) {
      const button = event.target.closest('.btn, .nav-cta, .mobile-menu, .close-modal');
      if (!button || document.documentElement.classList.contains('motion-paused')) return;
      button.classList.remove('button-pop');
      void button.offsetWidth;
      button.classList.add('button-pop');
      window.setTimeout(function() { button.classList.remove('button-pop'); }, 450);
      const rect = button.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'click-ripple';
      ripple.setAttribute('aria-hidden', 'true');
      ripple.style.left = (event.detail === 0 ? rect.width / 2 : event.clientX - rect.left) + 'px';
      ripple.style.top = (event.detail === 0 ? rect.height / 2 : event.clientY - rect.top) + 'px';
      button.appendChild(ripple);
      window.setTimeout(function() { ripple.remove(); }, 700);
    });
  </script>
  <dialog class="cart-dialog" id="cartDialog" aria-labelledby="cartTitle">
    <header class="cart-head">
      <div><h2 id="cartTitle">CARRINHO</h2><p id="cartSummary">0 itens selecionados</p></div>
      <button class="cart-close" type="button" aria-label="Fechar carrinho" onclick="closeCart()">×</button>
